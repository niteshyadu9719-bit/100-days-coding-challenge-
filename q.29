#include <stdio.h>

int main()
{
    int n, digit;
    int sum = 0, squareSum = 0;

    printf("Enter a four digit number: ");
    scanf("%d", &n);

    while(n > 0)
    {
        digit = n % 10;
        sum = sum + digit;
        squareSum = squareSum + digit * digit;
        n = n / 10;
    }

    printf("Sum of digits = %d\n", sum);
    printf("Sum of squares = %d\n", squareSum);

    return 0;
}

